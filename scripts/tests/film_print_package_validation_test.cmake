# Check malformed package inputs without compiling the application or using a GPU.
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED ALCEDO_TEST_DIR)
    message(FATAL_ERROR "Set ALCEDO_TEST_DIR to a new directory under build/tmp/")
endif()
cmake_path(ABSOLUTE_PATH ALCEDO_TEST_DIR NORMALIZE OUTPUT_VARIABLE _work)
set(_allowed "${_repo}/build/tmp")
cmake_path(IS_PREFIX _allowed "${_work}" NORMALIZE _inside)
if(NOT _inside OR EXISTS "${_work}")
    message(FATAL_ERROR "Use a new test directory under ${_allowed}: ${_work}")
endif()
file(MAKE_DIRECTORY "${_work}")
file(STRINGS "${_repo}/alcedo_studio/src/include/edit/runtime/film/film_array_file.hpp"
    _schema_line REGEX "^inline constexpr int kFilmResourceSchemaVersion = [0-9]+;")
string(REGEX MATCH "= ([0-9]+)" _match "${_schema_line}")
set(_schema "${CMAKE_MATCH_1}")
set(_valid "{\"schema_version\":${_schema},\"resources\":{}}")
foreach(_key IN ITEMS stock_bundle print_setup reflectance_table)
    set(_name "film_${_key}.bin")
    file(WRITE "${_work}/${_name}" "bytes of ${_key}\n")
    file(SIZE "${_work}/${_name}" _bytes)
    file(SHA256 "${_work}/${_name}" _hash)
    string(JSON _valid SET "${_valid}" resources "${_key}"
        "{\"file\":\"${_name}\",\"bytes\":${_bytes},\"sha256\":\"${_hash}\"}")
endforeach()

function(check_input name manifest expected_error)
    file(WRITE "${_work}/manifest.json" "${manifest}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DALCEDO_FILM_PRINT_RESOURCE_DIR=${_work}"
        -P "${_repo}/scripts/cmake/verify_film_print_resources.cmake"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(expected_error STREQUAL "")
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "${name}: valid input failed: ${_error}")
        endif()
    elseif(_result EQUAL 0 OR NOT _error MATCHES "${expected_error}")
        message(FATAL_ERROR "${name}: expected rejection '${expected_error}': ${_output}${_error}")
    endif()
    message(STATUS "PASS ${name}")
endfunction()

check_input(CompleteResourcesWithMatchingSizesAndHashesAreAccepted "${_valid}" "")
string(REGEX REPLACE "\n[ ]*" "" _compact "${_valid}")
check_input(CompactManifestIsAccepted "${_compact}" "")
string(JSON _invalid SET "${_valid}" schema_version 5)
check_input(OlderResourceSchemaIsRejected "${_invalid}" "is not application schema")
string(JSON _invalid SET "${_valid}" resources "{}")
check_input(EmptyResourceListIsRejected "${_invalid}" "stock_bundle.*not found")
string(JSON _invalid REMOVE "${_valid}" resources print_setup)
check_input(MissingRequiredResourceIsRejected "${_invalid}" "print_setup.*not found")
string(JSON _invalid SET "${_valid}" resources stock_bundle file "\"../film_stock_bundle.bin\"")
check_input(ResourcePathOutsidePackageIsRejected "${_invalid}" "must name film_stock_bundle.bin")
string(JSON _invalid SET "${_valid}" resources stock_bundle bytes 1)
check_input(WrongResourceByteCountIsRejected "${_invalid}" "size differs from manifest")
string(JSON _other_hash GET "${_valid}" resources print_setup sha256)
string(JSON _invalid SET "${_valid}" resources stock_bundle sha256 "\"${_other_hash}\"")
check_input(HashFromAnotherResourceIsRejected "${_invalid}" "SHA-256 differs from manifest")
file(WRITE "${_work}/film_stock_bundle.bin" "other stock_bundle\n")
check_input(ChangedResourceBytesAreRejected "${_valid}" "differs from manifest")
