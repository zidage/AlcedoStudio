# Exercise both install layouts without a GPU or platform SDK.
if(NOT DEFINED ALCEDO_TEST_DIR)
    message(FATAL_ERROR "Set ALCEDO_TEST_DIR to a new directory under build/tmp/.")
endif()
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
cmake_path(ABSOLUTE_PATH ALCEDO_TEST_DIR NORMALIZE OUTPUT_VARIABLE _work)
set(_allowed "${_repo}/build/tmp")
cmake_path(IS_PREFIX _allowed "${_work}" NORMALIZE _inside)
if(NOT _inside OR EXISTS "${_work}")
    message(FATAL_ERROR "Use a new test directory under ${_allowed}: ${_work}")
endif()
file(MAKE_DIRECTORY "${_work}")

function(check_layout name source_root relative)
    set(_source "${_work}/source/${relative}")
    set(_installed "${_work}/install/${name}/${relative}")
    file(WRITE "${_source}" "expected ${name} GPU asset\n")
    file(WRITE "${_installed}" "expected ${name} GPU asset\n")
    set(ALCEDO_GPU_ASSET_SOURCE_ROOT "${source_root}")
    set(ALCEDO_GPU_ASSET_DESTINATION "${name}")
    set(ALCEDO_GPU_ASSET_FILES "${_source}")
    set(_script "${_work}/${name}.cmake")
    configure_file("${_repo}/scripts/cmake/install_gpu_asset_checksums.cmake.in"
        "${_script}" @ONLY)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMAKE_INSTALL_PREFIX=${_work}/install"
        -P "${_script}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "${name}: valid installed bytes were rejected")
    endif()
    file(SHA256 "${_source}" _hash)
    file(READ "${_work}/install/${name}/runtime-assets.sha256" _manifest)
    string(REPLACE "\r\n" "\n" _manifest "${_manifest}")
    if(NOT _manifest STREQUAL "${_hash}  ${relative}\n")
        message(FATAL_ERROR "${name}: incorrect relative path or checksum: ${_manifest}")
    endif()
    file(WRITE "${_installed}" "stale installed asset\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMAKE_INSTALL_PREFIX=${_work}/install"
        -P "${_script}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(_result EQUAL 0 OR NOT _error MATCHES "Installed GPU asset differs from build input")
        message(FATAL_ERROR "${name}: stale installed bytes were accepted: ${_error}")
    endif()
    message(STATUS "PASS ${name}: relative path, build checksum, and stale installed bytes")
endfunction()

check_layout(opencl "${_work}/source" "include/color/math.h")
check_layout(metal "" "mask.metallib")
