# Hash build inputs and check the installed copies before recording the inventory.
set(_gpu_source_root "@ALCEDO_GPU_ASSET_SOURCE_ROOT@")
set(_gpu_install_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@ALCEDO_GPU_ASSET_DESTINATION@")
set(_gpu_files "@ALCEDO_GPU_ASSET_FILES@")
set(_gpu_checksums "")
foreach(_gpu_file IN LISTS _gpu_files)
    if(_gpu_source_root)
        file(RELATIVE_PATH _gpu_relative "${_gpu_source_root}" "${_gpu_file}")
    else()
        get_filename_component(_gpu_relative "${_gpu_file}" NAME)
    endif()
    file(SHA256 "${_gpu_file}" _gpu_expected)
    file(SHA256 "${_gpu_install_root}/${_gpu_relative}" _gpu_installed)
    if(NOT _gpu_installed STREQUAL _gpu_expected)
        message(FATAL_ERROR "Installed GPU asset differs from build input: ${_gpu_relative}")
    endif()
    string(APPEND _gpu_checksums "${_gpu_expected}  ${_gpu_relative}\n")
endforeach()
file(WRITE "${_gpu_install_root}/runtime-assets.sha256" "${_gpu_checksums}")
