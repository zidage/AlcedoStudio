# Share the application-owned schema version across both package verifiers.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../../alcedo_studio/src/include/edit/runtime/film/film_array_file.hpp"
    _film_schema_line REGEX "^inline constexpr int kFilmResourceSchemaVersion = [0-9]+;")
if(NOT _film_schema_line MATCHES "= ([0-9]+)")
    message(FATAL_ERROR "Cannot read the application's film resource schema version")
endif()
set(_film_expected_schema "${CMAKE_MATCH_1}")
if(NOT DEFINED ALCEDO_FILM_PRINT_RESOURCE_DIR OR NOT IS_DIRECTORY "${ALCEDO_FILM_PRINT_RESOURCE_DIR}")
    message(FATAL_ERROR "Film print resource directory does not exist: ${ALCEDO_FILM_PRINT_RESOURCE_DIR}")
endif()
file(READ "${ALCEDO_FILM_PRINT_RESOURCE_DIR}/manifest.json" _film_manifest)
string(JSON _film_schema GET "${_film_manifest}" schema_version)
if(NOT _film_schema STREQUAL _film_expected_schema)
    message(FATAL_ERROR "Film resource schema ${_film_schema} is not application schema ${_film_expected_schema}")
endif()
foreach(_film_key IN ITEMS stock_bundle print_setup reflectance_table)
    set(_film_expected_file "film_${_film_key}.bin")
    string(JSON _film_file GET "${_film_manifest}" resources "${_film_key}" file)
    if(NOT _film_file STREQUAL _film_expected_file)
        message(FATAL_ERROR "Film resource ${_film_key} must name ${_film_expected_file}: ${_film_file}")
    endif()
    set(_film_path "${ALCEDO_FILM_PRINT_RESOURCE_DIR}/${_film_file}")
    string(JSON _film_bytes GET "${_film_manifest}" resources "${_film_key}" bytes)
    file(SIZE "${_film_path}" _film_actual_bytes)
    if(NOT _film_bytes MATCHES "^[1-9][0-9]*$" OR NOT _film_actual_bytes STREQUAL _film_bytes)
        message(FATAL_ERROR "Film resource size differs from manifest: ${_film_path}")
    endif()
    string(JSON _film_sha256 GET "${_film_manifest}" resources "${_film_key}" sha256)
    file(SHA256 "${_film_path}" _film_actual_sha256)
    if(NOT _film_actual_sha256 STREQUAL _film_sha256)
        message(FATAL_ERROR "Film resource SHA-256 differs from manifest: ${_film_path}")
    endif()
endforeach()
message(STATUS "Film print resources verified: schema ${_film_schema}, ${ALCEDO_FILM_PRINT_RESOURCE_DIR}")
