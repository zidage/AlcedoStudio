<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded into ocl_probe_gbk.exe: the process runs with code page 936 (GBK), like an
     alcedo_main process on a Chinese Windows system without the UTF-8 option. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">zh-CN</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
