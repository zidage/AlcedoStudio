// Math functions of the Slang kernels of the Vulkan backend (vulkan_compute_backend_plan.md,
// sections 4.3 and phase VK3) that SPIR-V does not have, or does not give with the precision of
// the OpenCL built-in functions.
//
// GLSL.std.450 exp, exp2, log, log2, and pow have looser limits than OpenCL: exp2 has 3 + 2|x|
// ulp, log2 has only an absolute error of 2^-21 in [0.5, 2], and pow is exp2(y * log2(x)). The
// shared color curves amplify these errors: the ST 2084 decode subtracts a constant from a power
// near 1, so one ulp of that power is about 4e-5 of the decoded light near the peak, and the
// LogC4 decode has about 12 ulp from exp2 of a large argument (phase VK3 record). The functions
// below reduce the argument exactly and evaluate polynomials of plain arithmetic, about 1 ulp,
// with the same result on each driver.

#pragma once

static const float kAlcedoLn2Hi = 0.693145751953125f;  // ln 2 with 12 trailing zero bits
static const float kAlcedoLn2Lo = 1.428606765330187e-06f;
static const float kAlcedoLn2   = 0.693147180559945f;
static const float kAlcedoLog2E = 1.442695040888963f;

static float AlcedoInfinity() {
  return asfloat(0x7f800000u);
}

// v 2^n for n in [-150, 128], by the bits of the power of two (HLSL ldexp takes a float exponent
// and can become a multiplication by exp2). A result below the normal range can flush to 0.
static float AlcedoScaleByPowerOf2(float v, int n) {
  if (n > 127) {
    v = v * asfloat(0x7f000000u);  // 2^127
    n = n - 127;
  } else if (n < -126) {
    v = v * asfloat(0x00800000u);  // 2^-126
    n = n + 126;
  }
  return v * asfloat(uint(n + 127) << 23);
}

// The cube root. SPIR-V has no cbrt: exp2(log2(|x|) / 3) and one Newton step. Its difference from
// a double-precision cbrt has the size of the difference of the OpenCL cbrt (2 ulp); a second
// step changes the result by little (VX1, section 9.1). 0 stays 0, and the sign of x stays.
static float AlcedoCbrt(float x) {
  if (x == 0.0f) {
    return 0.0f;
  }
  const float a = abs(x);
  float       r = exp2(log2(a) * (1.0f / 3.0f));
  r             = r - (r * r * r - a) / (3.0f * r * r);
  return x < 0.0f ? -r : r;
}

// exp(r) - 1 for |r| <= 0.35: the Taylor series to r^9 (the next term is below 2e-10 of the sum).
static float AlcedoExpm1Reduced(float r) {
  return r * (1.0f +
              r * (0.5f +
                   r * (1.6666667e-1f +
                        r * (4.1666668e-2f +
                             r * (8.3333338e-3f +
                                  r * (1.3888889e-3f +
                                       r * (1.9841270e-4f +
                                            r * (2.4801587e-5f + r * 2.7557319e-6f))))))));
}

// ln(1 + u) for u in [-0.25, 0.5]: 2 atanh(s) with s = u / (2 + u), |s| <= 0.2, to s^11.
static float AlcedoLog1pReduced(float u) {
  const float s  = u / (2.0f + u);
  const float s2 = s * s;
  return 2.0f * s *
         (1.0f + s2 * (3.3333334e-1f +
                       s2 * (2.0e-1f + s2 * (1.4285715e-1f +
                                            s2 * (1.1111111e-1f + s2 * 9.0909094e-2f)))));
}

// e^x. n = round(x / ln 2), r = x - n ln 2 (Cody and Waite: n * kAlcedoLn2Hi is exact), then
// 2^n (1 + expm1(r)).
static float AlcedoExp(float x) {
  if (x > 88.72284f) {
    return AlcedoInfinity();
  }
  if (x < -103.97208f) {
    return 0.0f;
  }
  const float n = round(x * kAlcedoLog2E);
  const float r = (x - n * kAlcedoLn2Hi) - n * kAlcedoLn2Lo;
  return AlcedoScaleByPowerOf2(1.0f + AlcedoExpm1Reduced(r), int(n));
}

// 2^x. n = round(x), f = x - n (exact), then 2^n (1 + expm1(f ln 2)).
static float AlcedoExp2(float x) {
  if (x >= 128.0f) {
    return AlcedoInfinity();
  }
  if (x < -150.0f) {
    return 0.0f;
  }
  const float n = round(x);
  return AlcedoScaleByPowerOf2(1.0f + AlcedoExpm1Reduced((x - n) * kAlcedoLn2), int(n));
}

// x = m 2^e with m in [0.75, 1.5), from the bits of x (HLSL frexp gives a float exponent).
// @pre x is positive and finite.
static float AlcedoSplitMantissa(float x, out float e) {
  int bias = 0;
  if (x < asfloat(0x00800000u)) {  // below the normal range: scale by 2^24 first
    x    = x * 16777216.0f;
    bias = 24;
  }
  const uint bits     = asuint(x);
  int        exponent = int((bits >> 23) & 0xffu) - 126;
  float      m        = asfloat((bits & 0x007fffffu) | 0x3f000000u);  // m in [0.5, 1)
  if (m < 0.75f) {
    m        = m * 2.0f;
    exponent = exponent - 1;
  }
  e = float(exponent - bias);
  return m;
}

// ln x. ln x = e ln 2 + ln(1 + (m - 1)); m - 1 is exact. 0 gives -inf; a negative value, NaN, and
// +inf keep the GLSL.std.450 result.
static float AlcedoLog(float x) {
  if (!(x > 0.0f) || isinf(x)) {
    return log(x);
  }
  float       e = 0.0f;
  const float m = AlcedoSplitMantissa(x, e);
  return e * kAlcedoLn2Hi + (AlcedoLog1pReduced(m - 1.0f) + e * kAlcedoLn2Lo);
}

// log2 x = e + log2(m).
static float AlcedoLog2(float x) {
  if (!(x > 0.0f) || isinf(x)) {
    return log2(x);
  }
  float       e = 0.0f;
  const float m = AlcedoSplitMantissa(x, e);
  return e + AlcedoLog1pReduced(m - 1.0f) * kAlcedoLog2E;
}

static const float kAlcedoLog10TwoHi = 0.301025390625f;  // log10 2 with 12 trailing zero bits
static const float kAlcedoLog10TwoLo = 4.6050389811980175e-06f;
static const float kAlcedoLog10E     = 0.434294481903252f;

// log10 x = e log10 2 + ln(m) log10 e (phase VK7: the ACES 2.0 inverse of the raster input).
static float AlcedoLog10(float x) {
  if (!(x > 0.0f) || isinf(x)) {
    return log10(x);
  }
  float       e = 0.0f;
  const float m = AlcedoSplitMantissa(x, e);
  return e * kAlcedoLog10TwoHi +
         (AlcedoLog1pReduced(m - 1.0f) * kAlcedoLog10E + e * kAlcedoLog10TwoLo);
}

// x^y = e^(y ln x). A base that is not positive keeps the GLSL.std.450 result (the curves clamp
// their input before a power).
static float AlcedoPow(float x, float y) {
  if (!(x > 0.0f) || isinf(x)) {
    return pow(x, y);
  }
  if (y == 0.0f) {
    return 1.0f;
  }
  return AlcedoExp(y * AlcedoLog(x));
}

// ---- Trigonometric functions (phase VK5) ----------------------------------------------------
//
// GLSL.std.450 sin and cos have only an absolute error of 2^-11 in [-pi, pi], and tan, asin,
// atan, and atan2 are "inherited" from them. The lens projections of the Develop pass
// (lens_calib.slang) amplify these errors at the image border to a few hundredths of the value
// (VK5 record). The functions below are the single-precision Cephes forms: an exact reduction
// by pi / 4 with a three-part constant, then a polynomial of plain arithmetic, about 1 ulp for
// |x| < 8192. A larger argument keeps the GLSL.std.450 result (no lens or curve has one).

static const float kAlcedoFourOverPi = 1.27323954473516f;
static const float kAlcedoPiOver4A   = 0.78515625f;  // pi / 4 in three parts
static const float kAlcedoPiOver4B   = 2.4187564849853515625e-4f;
static const float kAlcedoPiOver4C   = 3.77489497744594108e-8f;
static const float kAlcedoPi         = 3.14159265358979f;
static const float kAlcedoHalfPi     = 1.57079632679490f;
static const float kAlcedoQuarterPi  = 0.785398163397448f;
static const float kAlcedoTrigLimit  = 8192.0f;

// The octant j of |x| (rounded up to an even octant) and the reduced argument in [-pi/4, pi/4].
static float AlcedoReduceOctant(float a, out int j) {
  j       = int(a * kAlcedoFourOverPi);
  float y = float(j);
  if ((j & 1) != 0) {
    j = j + 1;
    y = y + 1.0f;
  }
  j = j & 7;
  return ((a - y * kAlcedoPiOver4A) - y * kAlcedoPiOver4B) - y * kAlcedoPiOver4C;
}

static float AlcedoSinPoly(float z, float zz) {
  return ((-1.9515295891e-4f * zz + 8.3321608736e-3f) * zz - 1.6666654611e-1f) * zz * z + z;
}

static float AlcedoCosPoly(float zz) {
  return ((2.443315711809948e-5f * zz - 1.388731625493765e-3f) * zz + 4.166664568298827e-2f) *
             zz * zz -
         0.5f * zz + 1.0f;
}

static float AlcedoSin(float x) {
  const float a = abs(x);
  if (!(a < kAlcedoTrigLimit)) {
    return sin(x);
  }
  int         j;
  const float z    = AlcedoReduceOctant(a, j);
  bool        sign = x < 0.0f;
  if (j > 3) {
    sign = !sign;
    j    = j - 4;
  }
  const float zz = z * z;
  const float s  = (j == 1 || j == 2) ? AlcedoCosPoly(zz) : AlcedoSinPoly(z, zz);
  return sign ? -s : s;
}

static float AlcedoCos(float x) {
  const float a = abs(x);
  if (!(a < kAlcedoTrigLimit)) {
    return cos(x);
  }
  int         j;
  const float z    = AlcedoReduceOctant(a, j);
  bool        sign = false;
  if (j > 3) {
    sign = !sign;
    j    = j - 4;
  }
  if (j > 1) {
    sign = !sign;
  }
  const float zz = z * z;
  const float c  = (j == 1 || j == 2) ? AlcedoSinPoly(z, zz) : AlcedoCosPoly(zz);
  return sign ? -c : c;
}

static float AlcedoTan(float x) {
  const float a = abs(x);
  if (!(a < kAlcedoTrigLimit)) {
    return tan(x);
  }
  int         j;
  const float z  = AlcedoReduceOctant(a, j);
  const float zz = z * z;
  float       t  = z;
  if (zz > 1.0e-4f) {
    t = (((((9.38540185543e-3f * zz + 3.11992232697e-3f) * zz + 2.44301354525e-2f) * zz +
           5.34112807005e-2f) *
              zz +
          1.33387994085e-1f) *
             zz +
         3.33331568548e-1f) *
            zz * z +
        z;
  }
  if ((j & 2) != 0) {
    t = -1.0f / t;
  }
  return x < 0.0f ? -t : t;
}

static float AlcedoAtan(float x) {
  const float a      = abs(x);
  float       offset = 0.0f;
  float       v      = a;
  if (a > 2.414213562373095f) {  // tan(3 pi / 8)
    offset = kAlcedoHalfPi;
    v      = -1.0f / a;
  } else if (a > 0.4142135623730950f) {  // tan(pi / 8)
    offset = kAlcedoQuarterPi;
    v      = (a - 1.0f) / (a + 1.0f);
  }
  const float z = v * v;
  const float r = offset + ((((8.05374449538e-2f * z - 1.38776856032e-1f) * z +
                              1.99777106478e-1f) *
                                 z -
                             3.33329491539e-1f) *
                                z * v +
                            v);
  return x < 0.0f ? -r : r;
}

// The angle of (x, y) in [-pi, pi], the quadrants of the C atan2.
static float AlcedoAtan2(float y, float x) {
  if (x == 0.0f) {
    if (y > 0.0f) {
      return kAlcedoHalfPi;
    }
    if (y < 0.0f) {
      return -kAlcedoHalfPi;
    }
    return 0.0f;
  }
  if (y == 0.0f) {
    return x > 0.0f ? 0.0f : kAlcedoPi;
  }
  if (isinf(x) || isinf(y)) {
    return atan2(y, x);
  }
  const float r = AlcedoAtan(y / x);
  if (x > 0.0f) {
    return r;
  }
  return y > 0.0f ? r + kAlcedoPi : r - kAlcedoPi;
}

static float AlcedoAsin(float x) {
  const float a = abs(x);
  if (!(a <= 1.0f)) {
    return asin(x);  // NaN
  }
  if (a < 1.0e-4f) {
    return x;
  }
  float       v    = a;
  float       z    = a * a;
  const bool  wide = a > 0.5f;
  if (wide) {
    z = 0.5f * (1.0f - a);
    v = sqrt(z);
  }
  float r = ((((4.2163199048e-2f * z + 2.4181311049e-2f) * z + 4.5470025998e-2f) * z +
              7.4953002686e-2f) *
                 z +
             1.6666752422e-1f) *
                z * v +
            v;
  if (wide) {
    r = kAlcedoHalfPi - (r + r);
  }
  return x < 0.0f ? -r : r;
}

// x * y as one rounded multiply that the driver does not fuse with an add or a subtract into an
// FMA: the OpFMul has the SPIR-V NoContraction decoration. This is the Slang form of the OpenCL
// `#pragma OPENCL FP_CONTRACT OFF` (phase VK4). slangc 2025.17.2 writes no NoContraction for
// `precise` or for `-fp-mode precise`, so a kernel that needs the OpenCL rounding of each product
// calls this function for each multiply.
static float AlcedoExactMul(float x, float y) {
  return spirv_asm {
    %product:$$float = OpFMul $x $y;
    OpDecorate %product NoContraction;
    result:$$float = OpCopyObject %product;
  };
}

// x + y as one rounded add with the SPIR-V NoContraction decoration: the driver does not fuse it
// with a multiply and does not combine it with another add (phase VK4, see AlcedoExactMul).
static float AlcedoExactAdd(float x, float y) {
  return spirv_asm {
    %sum:$$float = OpFAdd $x $y;
    OpDecorate %sum NoContraction;
    result:$$float = OpCopyObject %sum;
  };
}
