// The display transform of the Vulkan DRT (plan #1036, phase VK12): the forward ACES 2.0 and
// OpenDRT math of opencl/shader/cst.cl, the display encoding, and DrtDisplayPixel of drt.cl, with
// the same arithmetic in the same order. The parameters are the block of
// edit/runtime/vulkan/vulkan_drt_layout.h, read by device address and word position (no buffer
// record with struct members: the Intel pipeline rule of phase VK4). The kernel group drt includes
// this file; the Negative Scan of the film print (phase VK14) shows its linear AP1 with
// DrtDisplayPixel too.
//
// pow, exp, log, log10, sin, cos, and atan2 are the math.slangh functions (the GLSL.std.450
// functions are less precise than the OpenCL built-in functions: phase VK3 and VK5 records).

#pragma once

#include "color/color_encoding_math.h"
#include "edit/runtime/aces_reference_gamut_compression.h"
#include "edit/runtime/vulkan/vulkan_drt_layout.h"
#include "vulkan/shader/math.slangh"

static const int   kDrtOdtTableSize        = 360;
static const int   kDrtOdtTotalTableSize   = 362;
static const int   kDrtOdtBaseIndex        = 1;
static const float kDrtOdtHueLimit         = 360.0f;
static const float kDrtRefLuminance        = 100.0f;
static const float kDrtJScale              = 100.0f;
static const float kDrtCamNlOffset         = 27.13f;
static const float kDrtSmoothCusps         = 0.12f;
static const float kDrtCuspMidBlend        = 1.3f;
static const float kDrtFocusGainBlend      = 0.3f;
static const float kDrtCompressionThreshold = 0.75f;
static const float kDrtHuntNj              = 0.012f;
static const float kDrtChromaJFloor        = 0.25f;
static const float kDrtRgbMappingFailure   = 8.0f;
static const float kDrtPi                  = 3.1415926535897932f;
static const float kDrtOpenDrtSqrt3        = 1.7320508075688772f;

// ---- Parameter block access ------------------------------------------------------------------

static float DrtF(uint64_t block, int word) { return *((float*)(block + uint64_t(word) * 4u)); }
static int   DrtI(uint64_t block, int word) { return *((int*)(block + uint64_t(word) * 4u)); }

// v * M of a matrix of nine words from `word` (the opencl_mat3_mul_global order).
static float3 DrtMulBlock(float3 v, uint64_t block, int word) {
  return float3(v.x * DrtF(block, word + 0) + v.y * DrtF(block, word + 3) +
                    v.z * DrtF(block, word + 6),
                v.x * DrtF(block, word + 1) + v.y * DrtF(block, word + 4) +
                    v.z * DrtF(block, word + 7),
                v.x * DrtF(block, word + 2) + v.y * DrtF(block, word + 5) +
                    v.z * DrtF(block, word + 8));
}

// M v of a constant matrix by rows (the opencl_odrt_apply_matrix order).
static float3 DrtRows(float3 r0, float3 r1, float3 r2, float3 v) {
  return float3(r0.x * v.x + r0.y * v.y + r0.z * v.z, r1.x * v.x + r1.y * v.y + r1.z * v.z,
                r2.x * v.x + r2.y * v.y + r2.z * v.z);
}

// ---- OpenCL built-in functions -----------------------------------------------------------------

static float DrtCopySign(float a, float b) {
  return asfloat((asuint(a) & 0x7fffffffu) | (asuint(b) & 0x80000000u));
}

// The OpenCL pow: 0^y, a negative base with an integer exponent, and NaN for the others.
static float DrtPow(float x, float y) {
  if (x > 0.0f) {
    return AlcedoPow(x, y);
  }
  if (x == 0.0f) {
    return y > 0.0f ? 0.0f : (y == 0.0f ? 1.0f : AlcedoInfinity());
  }
  if (isnan(x) || isnan(y)) {
    return x + y;
  }
  if (floor(y) != y) {
    return asfloat(0x7fc00000u);
  }
  const float magnitude = AlcedoPow(-x, y);
  return (abs(fmod(y, 2.0f)) == 1.0f) ? -magnitude : magnitude;
}

// The C fmod (OpFRem has the sign of x).
static float DrtFmod(float x, float y) { return fmod(x, y); }

// ---- Shared CST math ---------------------------------------------------------------------------

static float DrtClampF(float x, float lo, float hi) { return min(max(x, lo), hi); }
static int   DrtClampI(int x, int lo, int hi) { return x < lo ? lo : (x > hi ? hi : x); }
static float DrtSafeSqrt(float x) { return sqrt(max(x, 0.0f)); }

static float DrtSafeDiv(float a, float b, float eps) {
  const float ab = abs(b);
  const float bb = (ab < eps) ? DrtCopySign(eps, b) : b;
  return a / bb;
}

static float DrtSafeLog10Ratio(float num, float den, float eps) {
  return AlcedoLog10(max(num, eps) / max(den, eps));
}

static float DrtSafePowPos(float base, float expv) {
  const float b = max(base, 0.0f);
  if (b == 0.0f) {
    return (expv > 0.0f) ? 0.0f : 1.0f;
  }
  return DrtPow(b, expv);
}

static float DrtWrapTo360(float hue) {
  if (!isfinite(hue)) return 0.0f;
  const float y = DrtFmod(hue, 360.0f);
  return y + ((y < 0.0f) ? 360.0f : 0.0f);
}

static float DrtDegreesToRadians(float deg) { return deg * (kDrtPi / 180.0f); }
static float DrtRadiansToDegrees(float rad) { return rad * (180.0f / kDrtPi); }

// ---- Display encoding (color/color_encoding_math.h) ------------------------------------------

static float3 DrtDisplayEncoding(float3 rgb, uint64_t block) {
  const int    eotf     = DrtI(block, ALCEDO_VK_DRT_EOTF);
  const float3 scaled   = DrtMulBlock(rgb, block, ALCEDO_VK_DRT_LIMIT_TO_DISPLAY) *
                          DrtF(block, ALCEDO_VK_DRT_DISPLAY_LINEAR_SCALE);
  const float  hlg_gain = eotf == CE_TF_HLG ? CeHlgDisplayGain(scaled.x, scaled.y, scaled.z) : 1.0f;
  return float3(CeDisplayEncodeChannel(eotf, scaled.x, hlg_gain),
                CeDisplayEncodeChannel(eotf, scaled.y, hlg_gain),
                CeDisplayEncodeChannel(eotf, scaled.z, hlg_gain));
}

// ---- ACES 2.0 output transform ---------------------------------------------------------------

struct DrtHueDependentGamutParams {
  float2 JMcusp;
  float  gamma_bottom_inv;
  float  gamma_top_inv;
  float  focus_J;
  float  analytical_threshold;
};

static float DrtTonescaleFwd(float x, uint64_t block) {
  const int ts = ALCEDO_VK_DRT_ACES_TS;
  if (!isfinite(x)) {
    if (x > 0.0f) {
      const float f_inf = DrtF(block, ts + ALCEDO_VK_DRT_TS_M_2);
      const float h_inf = max(0.0f, f_inf * f_inf / (f_inf + DrtF(block, ts + ALCEDO_VK_DRT_TS_T_1)));
      return h_inf * DrtF(block, ts + ALCEDO_VK_DRT_TS_N_R);
    }
    return 0.0f;
  }
  const float denom = x + DrtF(block, ts + ALCEDO_VK_DRT_TS_S_2);
  const float ratio = (denom > 1e-7f) ? (max(0.0f, x) / denom) : 0.0f;
  const float f     = DrtF(block, ts + ALCEDO_VK_DRT_TS_M_2) *
                  DrtPow(ratio, DrtF(block, ts + ALCEDO_VK_DRT_TS_G));
  const float h = max(0.0f, f * f / (f + DrtF(block, ts + ALCEDO_VK_DRT_TS_T_1)));
  return h * DrtF(block, ts + ALCEDO_VK_DRT_TS_N_R);
}

static float DrtPacrcFwd(float v) {
  const float abs_v = abs(v);
  const float F_L_Y = DrtSafePowPos(abs_v, 0.42f);
  const float Rc    = F_L_Y / (kDrtCamNlOffset + F_L_Y);
  return DrtCopySign(Rc, v);
}

static float DrtPacrcInv(float v) {
  const float abs_v = abs(v);
  if (!isfinite(abs_v) || abs_v <= 0.0f) {
    return 0.0f;
  }
  const float Ra_lim = min(abs_v, 0.99f);
  const float F_L_Y  = (kDrtCamNlOffset * Ra_lim) / (1.0f - Ra_lim);
  return DrtCopySign(DrtSafePowPos(F_L_Y, 1.0f / 0.42f), v);
}

static float DrtAchromaticNToJ(float A, float cz) {
  return kDrtJScale * DrtSafePowPos(max(A, 0.0f), cz);
}

static float DrtJToAchromaticN(float J, float inv_cz) {
  return DrtSafePowPos(max(J, 0.0f) * (1.0f / kDrtJScale), inv_cz);
}

// `jmh` is the first word of a JMh parameter set (ALCEDO_VK_DRT_ACES_INPUT, _REACH, _LIMIT).
static float3 DrtRgbToAab(float3 RGB, uint64_t block, int jmh) {
  const float3 RGB_m = DrtMulBlock(RGB, block, jmh + ALCEDO_VK_DRT_JMH_RGB_TO_CAM16);
  const float3 RGB_a = float3(DrtPacrcFwd(RGB_m.x), DrtPacrcFwd(RGB_m.y), DrtPacrcFwd(RGB_m.z));
  return DrtMulBlock(RGB_a, block, jmh + ALCEDO_VK_DRT_JMH_CONE_TO_AAB);
}

static float3 DrtAabToJmh(float3 Aab, uint64_t block, int jmh) {
  const float mask = Aab.x > 0.0f ? 1.0f : 0.0f;
  const float J    = DrtAchromaticNToJ(Aab.x, DrtF(block, jmh + ALCEDO_VK_DRT_JMH_CZ)) * mask;
  const float M    = DrtSafeSqrt(Aab.y * Aab.y + Aab.z * Aab.z) * mask;
  const float h    = DrtWrapTo360(DrtRadiansToDegrees(AlcedoAtan2(Aab.z, Aab.y))) * mask;
  return float3(J, M, h);
}

static float3 DrtJmhToAab(float3 JMh, uint64_t block, int jmh) {
  const float h_rad = DrtDegreesToRadians(JMh.z);
  const float A     = DrtJToAchromaticN(JMh.x, DrtF(block, jmh + ALCEDO_VK_DRT_JMH_INV_CZ));
  return float3(A, JMh.y * AlcedoCos(h_rad), JMh.y * AlcedoSin(h_rad));
}

static float3 DrtAabToRgb(float3 Aab, uint64_t block, int jmh) {
  const float3 RGB_a = DrtMulBlock(Aab, block, jmh + ALCEDO_VK_DRT_JMH_AAB_TO_CONE);
  const float3 RGB_m = float3(DrtPacrcInv(RGB_a.x), DrtPacrcInv(RGB_a.y), DrtPacrcInv(RGB_a.z));
  return DrtMulBlock(RGB_m, block, jmh + ALCEDO_VK_DRT_JMH_CAM16_TO_RGB);
}

static float3 DrtRgbToJmh(float3 color, uint64_t block, int jmh) {
  return DrtAabToJmh(DrtRgbToAab(color, block, jmh), block, jmh);
}

static float3 DrtJmhToRgb(float3 JMh, uint64_t block, int jmh) {
  return DrtAabToRgb(DrtJmhToAab(JMh, block, jmh), block, jmh);
}

static float DrtAToY(float A, uint64_t block, int jmh) {
  if (!isfinite(A) || A <= 0.0f) {
    return 0.0f;
  }
  const float Ra = DrtF(block, jmh + ALCEDO_VK_DRT_JMH_A_W_J) * A;
  return DrtPacrcInv(Ra) / DrtF(block, jmh + ALCEDO_VK_DRT_JMH_F_L_N);
}

static float DrtJToY(float J, uint64_t block, int jmh) {
  return DrtAToY(DrtJToAchromaticN(abs(J), DrtF(block, jmh + ALCEDO_VK_DRT_JMH_INV_CZ)), block,
                 jmh);
}

static float DrtYToJ(float Y, uint64_t block, int jmh) {
  const float Ra = DrtPacrcFwd(abs(Y) * DrtF(block, jmh + ALCEDO_VK_DRT_JMH_F_L_N));
  const float J  = DrtAchromaticNToJ(Ra * DrtF(block, jmh + ALCEDO_VK_DRT_JMH_INV_A_W_J),
                                     DrtF(block, jmh + ALCEDO_VK_DRT_JMH_CZ));
  return DrtCopySign(J, Y);
}

static float DrtReachMFromTable(float h, uint64_t block) {
  const float hw   = DrtWrapTo360(h);
  const float pos  = hw * (float(kDrtOdtTableSize) / kDrtOdtHueLimit);
  const int   base = DrtClampI(int(pos), 0, kDrtOdtTableSize - 1);
  const float t    = DrtClampF(pos - float(base), 0.0f, 1.0f);
  const int   i_lo = base + kDrtOdtBaseIndex;
  const int   i_hi = i_lo + 1;
  const float lo   = DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_REACH_M + i_lo);
  const float hi   = DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_REACH_M + i_hi);
  return lo + (hi - lo) * t;
}

static float DrtHuntColorfulnessFactor(float nJ) {
  const float nj = max(nJ, 0.0f);
  const float t2 = kDrtHuntNj * kDrtHuntNj;
  return (nj * nj) / (nj * nj + t2);
}

static float DrtChromaCompressNorm(float h, float chroma_compress_scale) {
  const float hr      = DrtDegreesToRadians(h);
  const float a       = AlcedoCos(hr);
  const float b       = AlcedoSin(hr);
  const float cos_hr2 = a * a - b * b;
  const float sin_hr2 = 2.0f * a * b;
  const float cos_hr3 = 4.0f * a * a * a - 3.0f * a;
  const float sin_hr3 = 3.0f * b - 4.0f * b * b * b;
  return (11.34072f * a + 16.46899f * cos_hr2 + 7.88380f * cos_hr3 + 14.66441f * b -
          6.37224f * sin_hr2 + 9.19364f * sin_hr3 + 77.12896f) *
         chroma_compress_scale;
}

static float DrtToe(float x, float limit, float k1_in, float k2_in) {
  if (x > limit) return x;
  const float k2      = max(k2_in, 0.001f);
  const float k1      = sqrt(k1_in * k1_in + k2 * k2);
  const float k3      = (limit + k1) / (limit + k2);
  const float minus_b = k3 * x - k1;
  const float minus_c = k2 * k3 * x;
  return 0.5f * (minus_b + DrtSafeSqrt(minus_b * minus_b + 4.0f * minus_c));
}

static float3 DrtChromaCompressFwd(float3 JMh, float tonemapped_J, uint64_t block) {
  const float J       = JMh.x;
  const float M       = JMh.y;
  const float h       = JMh.z;
  float       M_compr = M;
  if (M != 0.0f) {
    const float limitJ          = max(DrtF(block, ALCEDO_VK_DRT_ACES_LIMIT_J_MAX), 1e-6f);
    const float Jts             = max(tonemapped_J, 0.0f);
    const float nJ              = DrtClampF(Jts / limitJ, 0.0f, 1.0f);
    const float snJ             = max(0.0f, 1.0f - nJ);
    const float model_gamma_inv = DrtF(block, ALCEDO_VK_DRT_ACES_MODEL_GAMMA_INV);
    const float Mnorm =
        DrtChromaCompressNorm(h, DrtF(block, ALCEDO_VK_DRT_ACES_CHROMA_COMPRESS_SCALE));
    if (!isfinite(Mnorm) || abs(Mnorm) < 1e-6f) {
      return float3(Jts, 0.0f, h);
    }
    float limit = DrtSafePowPos(nJ, model_gamma_inv) * DrtReachMFromTable(h, block) / Mnorm;
    limit       = max(limit, 0.0f);
    const float nJ_in   = DrtClampF(max(J, 0.0f) / limitJ, 0.0f, 1.0f);
    const float j_denom = max(abs(J), kDrtChromaJFloor);
    const float ratio   = Jts / j_denom;
    M_compr = M * DrtHuntColorfulnessFactor(nJ_in) * DrtSafePowPos(ratio, model_gamma_inv);
    M_compr = M_compr / Mnorm;
    M_compr = limit - DrtToe(limit - M_compr, limit - 0.001f,
                             snJ * DrtF(block, ALCEDO_VK_DRT_ACES_SAT),
                             sqrt(nJ * nJ + DrtF(block, ALCEDO_VK_DRT_ACES_SAT_THR)));
    M_compr = DrtToe(M_compr, limit, nJ * DrtF(block, ALCEDO_VK_DRT_ACES_COMPR), snJ);
    M_compr *= Mnorm;
    M_compr *= DrtHuntColorfulnessFactor(nJ);
  }
  return float3(tonemapped_J, M_compr, h);
}

static float3 DrtTonemapAndCompressFwd(float3 JMh, uint64_t block) {
  const float linear       = DrtJToY(JMh.x, block, ALCEDO_VK_DRT_ACES_INPUT) / kDrtRefLuminance;
  const float tonemapped_Y = DrtTonescaleFwd(linear, block);
  const float J_ts         = DrtYToJ(tonemapped_Y, block, ALCEDO_VK_DRT_ACES_INPUT);
  return DrtChromaCompressFwd(JMh, J_ts, block);
}

static int DrtHuePositionInUniformTable(float hue, int table_size) {
  const float wrapped = DrtWrapTo360(hue);
  const float pos     = wrapped * (float(table_size) / kDrtOdtHueLimit);
  return DrtClampI(int(pos), 0, table_size - 1);
}

static float DrtHueIntervalWeight(float h, float h_lo, float h_hi) {
  const float denom = h_hi - h_lo;
  if (abs(denom) < 1e-6f) return 0.0f;
  return clamp((h - h_lo) / denom, 0.0f, 1.0f);
}

static int DrtLookHueInterval(float h, uint64_t block) {
  const float hw = DrtWrapTo360(h);
  int         i  = kDrtOdtBaseIndex + DrtHuePositionInUniformTable(hw, kDrtOdtTotalTableSize);
  int         i_lo = i + DrtI(block, ALCEDO_VK_DRT_ACES_HUE_SEARCH_LO);
  int         i_hi = i + DrtI(block, ALCEDO_VK_DRT_ACES_HUE_SEARCH_HI);
  i_lo = i_lo < kDrtOdtBaseIndex ? kDrtOdtBaseIndex : i_lo;
  i_hi = i_hi > (kDrtOdtBaseIndex + kDrtOdtTableSize) ? (kDrtOdtBaseIndex + kDrtOdtTableSize)
                                                      : i_hi;
  if (i_lo > i_hi) {
    i_lo = kDrtOdtBaseIndex;
    i_hi = kDrtOdtBaseIndex + kDrtOdtTableSize;
  }
  i = (i_lo + i_hi) >> 1;
  for (int k = 0; k < 16 && (i_lo + 1 < i_hi); ++k) {
    const float v  = DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_HUES + i);
    const bool  gt = hw > v;
    i_lo           = gt ? i : i_lo;
    i_hi           = gt ? i_hi : i;
    i              = (i_lo + i_hi) >> 1;
  }
  return (i_hi < 1) ? 1 : i_hi;
}

static float DrtCusp(uint64_t block, int index, int component) {
  return DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_GAMUT_CUSPS + 4 * index + component);
}

static float2 DrtCuspFromTable(float h, uint64_t block) {
  const float hw     = DrtWrapTo360(h);
  int         low_i  = 0;
  int         high_i = kDrtOdtBaseIndex + kDrtOdtTableSize;
  int         i      = kDrtOdtBaseIndex + DrtHuePositionInUniformTable(hw, kDrtOdtTableSize);
  for (int k = 0; k < 10 && (low_i + 1 < high_i); ++k) {
    const float h_i = DrtCusp(block, i, 2);
    const bool  gt  = hw > h_i;
    low_i           = gt ? i : low_i;
    high_i          = gt ? high_i : i;
    i               = (low_i + high_i) >> 1;
  }
  const int   lo_i  = high_i - 1;
  const int   hi_i  = high_i;
  const float denom = DrtCusp(block, hi_i, 2) - DrtCusp(block, lo_i, 2);
  const float t =
      clamp((abs(denom) > 1e-6f) ? (hw - DrtCusp(block, lo_i, 2)) / denom : 0.0f, 0.0f, 1.0f);
  return float2(DrtCusp(block, lo_i, 0) + (DrtCusp(block, hi_i, 0) - DrtCusp(block, lo_i, 0)) * t,
                DrtCusp(block, lo_i, 1) + (DrtCusp(block, hi_i, 1) - DrtCusp(block, lo_i, 1)) * t);
}

static DrtHueDependentGamutParams DrtInitHueDependentGamutParams(float h, uint64_t block) {
  DrtHueDependentGamutParams hdp;
  hdp.gamma_bottom_inv = DrtF(block, ALCEDO_VK_DRT_ACES_LOWER_HULL_GAMMA_INV);
  const int   i_hi     = DrtLookHueInterval(h, block);
  const float hw       = DrtWrapTo360(h);
  const float t        = DrtHueIntervalWeight(hw, DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_HUES + i_hi - 1),
                                              DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_HUES + i_hi));
  hdp.JMcusp           = DrtCuspFromTable(h, block);
  const float gamma_lo = DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_UPPER_HULL_GAMMA + i_hi - 1);
  const float gamma_hi = DrtF(block, ALCEDO_VK_DRT_ACES_TABLE_UPPER_HULL_GAMMA + i_hi);
  hdp.gamma_top_inv    = clamp(gamma_lo + (gamma_hi - gamma_lo) * t, 0.05f, 8.0f);
  const float limit_J_max = DrtF(block, ALCEDO_VK_DRT_ACES_LIMIT_J_MAX);
  hdp.focus_J = hdp.JMcusp.x + (DrtF(block, ALCEDO_VK_DRT_ACES_MID_J) - hdp.JMcusp.x) *
                                   min(1.0f, kDrtCuspMidBlend - (hdp.JMcusp.x / limit_J_max));
  hdp.analytical_threshold = hdp.JMcusp.x + (limit_J_max - hdp.JMcusp.x) * kDrtFocusGainBlend;
  return hdp;
}

static float DrtGetFocusGain(float J, float analytical_threshold, float limit_J_max,
                             float focus_dist) {
  float gain = limit_J_max * focus_dist;
  if (J > analytical_threshold) {
    const float adj =
        DrtSafeLog10Ratio(limit_J_max - analytical_threshold, limit_J_max - J, 1e-4f);
    gain *= adj * adj + 1.0f;
  }
  return gain;
}

static float DrtSolveJIntersect(float J, float M, float focusJ, float maxJ, float slope_gain) {
  const float sg       = max(abs(slope_gain), 1e-6f);
  const float fj       = max(abs(focusJ), 1e-6f);
  const float M_scaled = M / sg;
  const float a        = M_scaled / fj;
  const float b1       = 1.0f - M_scaled;
  const float c1       = -J;
  const float r1 =
      (b1 * b1 - 4.0f * a * c1 > 0.0f) ? DrtSafeSqrt(b1 * b1 - 4.0f * a * c1) : 0.0f;
  const float den1 = DrtCopySign(max(abs(b1 + r1), 1e-6f), b1 + r1);
  const float res1 = (-2.0f * c1) / den1;
  const float b2   = -(1.0f + M_scaled + maxJ * a);
  const float c2   = maxJ * M_scaled + J;
  const float r2 =
      (b2 * b2 - 4.0f * a * c2 > 0.0f) ? DrtSafeSqrt(b2 * b2 - 4.0f * a * c2) : 0.0f;
  const float den2 = DrtCopySign(max(abs(b2 - r2), 1e-6f), b2 - r2);
  const float res2 = (-2.0f * c2) / den2;
  return (J < focusJ) ? res1 : res2;
}

static float DrtEstimateLineBoundaryM(float J_axis_intersect, float slope, float inv_gamma,
                                      float J_max, float M_max, float J_intersection_reference) {
  const float refJ = max(J_intersection_reference, 1e-6f);
  const float shifted =
      refJ * DrtSafePowPos(max(J_axis_intersect / refJ, 0.0f), inv_gamma);
  const float denom =
      DrtCopySign(max(abs(J_max - slope * M_max), 1e-6f), J_max - slope * M_max);
  return shifted * M_max / denom;
}

static float DrtSminScaled(float a, float b, float scale_reference) {
  const float s_scaled = kDrtSmoothCusps * scale_reference;
  if (s_scaled <= 1e-6f) return min(a, b);
  const float h = max(s_scaled - abs(a - b), 0.0f) / s_scaled;
  return min(a, b) - h * h * h * s_scaled * (1.0f / 6.0f);
}

static float DrtFindGamutBoundaryIntersection(float2 JM_cusp, float J_max, float gamma_top_inv,
                                              float gamma_bottom_inv, float J_intersect_source,
                                              float slope, float J_intersect_cusp) {
  const float lower = DrtEstimateLineBoundaryM(J_intersect_source, slope, gamma_bottom_inv,
                                               JM_cusp.x, JM_cusp.y, J_intersect_cusp);
  const float upper =
      DrtEstimateLineBoundaryM(J_max - J_intersect_source, -slope, gamma_top_inv,
                               J_max - JM_cusp.x, JM_cusp.y, J_max - J_intersect_cusp);
  return DrtSminScaled(lower, upper, JM_cusp.y);
}

static float DrtRemapM(float M, float gamut_boundary_M, float reach_boundary_M) {
  const float boundary_ratio = DrtSafeDiv(gamut_boundary_M, reach_boundary_M, 1e-6f);
  const float proportion     = max(boundary_ratio, kDrtCompressionThreshold);
  const float threshold      = proportion * gamut_boundary_M;
  if (M <= threshold || proportion >= 1.0f) return M;
  const float m_offset  = M - threshold;
  const float gamut_off = gamut_boundary_M - threshold;
  const float reach_off = reach_boundary_M - threshold;
  const float ratio_rg  = DrtSafeDiv(reach_off, gamut_off, 1e-6f);
  const float scale     = reach_off / max(ratio_rg - 1.0f, 1e-7f);
  const float nd        = m_offset / scale;
  return threshold + scale * nd / (1.0f + nd);
}

static float3 DrtCompressGamut(float3 JMh, float Jx, uint64_t block,
                               DrtHueDependentGamutParams hdp) {
  const float limit_J_max = DrtF(block, ALCEDO_VK_DRT_ACES_LIMIT_J_MAX);
  const float slope_gain =
      max(DrtGetFocusGain(Jx, hdp.analytical_threshold, limit_J_max,
                          DrtF(block, ALCEDO_VK_DRT_ACES_FOCUS_DIST)),
          1e-6f);
  const float J_intersect_source =
      DrtSolveJIntersect(JMh.x, JMh.y, hdp.focus_J, limit_J_max, slope_gain);
  const float direction_scalar =
      (J_intersect_source < hdp.focus_J) ? J_intersect_source : limit_J_max - J_intersect_source;
  const float gamut_slope = direction_scalar * (J_intersect_source - hdp.focus_J) /
                            max(abs(hdp.focus_J * slope_gain), 1e-6f);
  const float J_intersect_cusp =
      DrtSolveJIntersect(hdp.JMcusp.x, hdp.JMcusp.y, hdp.focus_J, limit_J_max, slope_gain);
  const float gamut_boundary_M = DrtFindGamutBoundaryIntersection(
      hdp.JMcusp, limit_J_max, hdp.gamma_top_inv, hdp.gamma_bottom_inv, J_intersect_source,
      gamut_slope, J_intersect_cusp);
  if (gamut_boundary_M <= 0.0f) {
    return float3(Jx, 0.0f, JMh.z);
  }
  const float reach_max_M = max(DrtReachMFromTable(JMh.z, block), 0.0f);
  const float reach_boundary_M = DrtEstimateLineBoundaryM(
      J_intersect_source, gamut_slope, DrtF(block, ALCEDO_VK_DRT_ACES_MODEL_GAMMA_INV),
      limit_J_max, reach_max_M, limit_J_max);
  const float remapped_M = DrtRemapM(JMh.y, gamut_boundary_M, reach_boundary_M);
  const float J_out      = J_intersect_source + remapped_M * gamut_slope;
  if (!isfinite(J_out) || !isfinite(remapped_M) || J_out < 0.0f ||
      J_out > limit_J_max * 1.05f) {
    return float3(DrtClampF(max(Jx, 0.0f), 0.0f, limit_J_max), 0.0f, JMh.z);
  }
  return float3(DrtClampF(J_out, 0.0f, limit_J_max), max(remapped_M, 0.0f), JMh.z);
}

static float3 DrtGamutCompressFwd(float3 JMh, uint64_t block) {
  if (JMh.x <= 1.0e-3f) return float3(0.0f, 0.0f, JMh.z);
  if (JMh.y <= 0.0f || JMh.x > DrtF(block, ALCEDO_VK_DRT_ACES_LIMIT_J_MAX))
    return float3(JMh.x, 0.0f, JMh.z);
  const DrtHueDependentGamutParams hdp = DrtInitHueDependentGamutParams(JMh.z, block);
  return DrtCompressGamut(JMh, JMh.x, block, hdp);
}

// AP1 to AP0 (the opencl_mat3_mul_private order: v.x * m[0] + v.y * m[3] + v.z * m[6]).
static float3 DrtAp1ToAp0(float3 ap1) {
  return float3(ap1.x * 0.695452213f + ap1.y * 0.140678704f + ap1.z * 0.163869068f,
                ap1.x * 0.0447945632f + ap1.y * 0.859671116f + ap1.z * 0.0955343172f,
                ap1.x * -0.00552588236f + ap1.y * 0.00402521016f + ap1.z * 1.00150073f);
}

static float3 DrtLimitRgbPreserveChroma(float3 rgb, float lower, float upper) {
  if (!isfinite(rgb.x) || !isfinite(rgb.y) || !isfinite(rgb.z)) return float3(0.0f);
  rgb           = max(rgb, float3(lower));
  const float m = max(rgb.x, max(rgb.y, rgb.z));
  if (m > upper * kDrtRgbMappingFailure) return float3(0.0f);
  if (m > upper && m > 0.0f) rgb *= upper / m;
  return rgb;
}

static float3 DrtAcesOutputTransformFwd(float3 in_color, uint64_t block) {
  if (!isfinite(in_color.x) || !isfinite(in_color.y) || !isfinite(in_color.z)) {
    return float3(0.0f);
  }
  const float3 ap0            = DrtAp1ToAp0(in_color);
  const float3 JMh            = DrtRgbToJmh(ap0, block, ALCEDO_VK_DRT_ACES_INPUT);
  const float3 tonemapped_JMh = DrtTonemapAndCompressFwd(JMh, block);
  const float3 compressed_JMh = DrtGamutCompressFwd(tonemapped_JMh, block);
  const float3 out_rgb        = DrtJmhToRgb(compressed_JMh, block, ALCEDO_VK_DRT_ACES_LIMIT);
  return DrtLimitRgbPreserveChroma(
      out_rgb, 0.0f, DrtF(block, ALCEDO_VK_DRT_ACES_TS + ALCEDO_VK_DRT_TS_FORWARD_LIMIT));
}

// ---- OpenDRT output transform ----------------------------------------------------------------

static float DrtOdrtSpowf(float a, float b) { return (a <= 0.0f) ? a : DrtPow(a, b); }

static float DrtOdrtHypot2(float2 v) { return sqrt(max(0.0f, v.x * v.x + v.y * v.y)); }

static float DrtOdrtHypot3(float3 v) { return sqrt(max(0.0f, v.x * v.x + v.y * v.y + v.z * v.z)); }

static float DrtOdrtCompressHyperbolicPower(float x, float s, float p) {
  return DrtOdrtSpowf(x / (x + s), p);
}

static float DrtOdrtCompressToeQuadratic(float x, float toe) {
  return (toe == 0.0f) ? x : DrtOdrtSpowf(x, 2.0f) / (x + toe);
}

static float DrtOdrtCompressToeCubic(float x, float m, float w, int inv) {
  if (m == 1.0f) return x;
  const float x2 = x * x;
  if (inv == 0) {
    return x * (x2 + m * w) / (x2 + w);
  }
  const float p0 = x2 - 3.0f * m * w;
  const float p1 = 2.0f * x2 + 27.0f * w - 9.0f * m * w;
  const float p2 =
      DrtPow(sqrt(x2 * p1 * p1 - 4.0f * p0 * p0 * p0) / 2.0f + x * p1 / 2.0f, 1.0f / 3.0f);
  return p0 / (3.0f * p2) + p2 / 3.0f + x / 3.0f;
}

static float DrtOdrtContrastHigh(float x, float p, float pv, float pv_lx) {
  const float x0 = 0.18f * DrtPow(2.0f, pv);
  if (x < x0 || p == 1.0f) return x;
  const float o  = x0 - x0 / p;
  const float s0 = DrtPow(x0, 1.0f - p) / p;
  const float x1 = x0 * DrtPow(2.0f, pv_lx);
  const float k1 = p * s0 * DrtPow(x1, p) / x1;
  const float y1 = s0 * DrtPow(x1, p) + o;
  return (x > x1) ? k1 * (x - x1) + y1 : s0 * DrtPow(x, p) + o;
}

static float DrtOdrtSoftplus(float x, float s) {
  if (x > 10.0f * s || s < 1e-4f) return x;
  return s * AlcedoLog(max(0.0f, 1.0f + AlcedoExp(x / s)));
}

static float DrtOdrtGaussWindow(float x, float w) { return AlcedoExp(-x * x / w); }

static float2 DrtOdrtOpponent(float3 rgb) {
  return float2(rgb.x - rgb.z, rgb.y - (rgb.x + rgb.z) / 2.0f);
}

static float DrtOdrtHueOffset(float h, float o) {
  return DrtFmod(h - o + kDrtPi, 2.0f * kDrtPi) - kDrtPi;
}

static float3 DrtOdrtDisplayGamutWhitepoint(float3 rgb, float tsn, float cwp_lm, int display_gamut,
                                            int cwp) {
  // P3D65 to XYZ.
  rgb = DrtRows(float3(0.4865709486f, 0.2656676932f, 0.1982172852f),
                float3(0.2289745641f, 0.6917385218f, 0.0792869141f),
                float3(0.0f, 0.0451133819f, 1.0439443689f), rgb);
  const float3 cwp_neutral = rgb;
  const float  cwp_f       = DrtPow(tsn, 2.0f * cwp_lm);
  if (display_gamut == 3 && cwp == 2) {
    // CAT D60 to D65.
    rgb = DrtRows(float3(0.9883639216f, -0.0076691005f, 0.0167641640f),
                  float3(-0.0055409619f, 0.9985461235f, 0.0066733211f),
                  float3(0.0003515370f, 0.0011288375f, 1.0783357620f), rgb);
  } else if (display_gamut < 3 && cwp == 3) {
    // CAT D65 to D60.
    rgb = DrtRows(float3(1.0118224621f, 0.0077887932f, -0.0157783031f),
                  float3(0.0056168283f, 1.0015064478f, -0.0062851757f),
                  float3(-0.0003357357f, -0.0010509500f, 0.9273666739f), rgb);
  }
  rgb = rgb * cwp_f + cwp_neutral * (1.0f - cwp_f);
  if (display_gamut == 0) {
    // XYZ to Rec.709.
    rgb = DrtRows(float3(3.2409699419f, -1.5373831776f, -0.4986107603f),
                  float3(-0.9692436363f, 1.8759675015f, 0.0415550574f),
                  float3(0.0556300797f, -0.2039769589f, 1.0569715142f), rgb);
  } else if (display_gamut == 5) {
    // CAT D65 to DCI.
    rgb = DrtRows(float3(0.9910855889f, -0.0273622870f, -0.0183956623f),
                  float3(-0.0191021916f, 1.0258377790f, -0.0070537254f),
                  float3(-0.0000805503f, -0.0019598883f, 0.8782384396f), rgb);
  } else {
    // XYZ to P3D65.
    rgb = DrtRows(float3(2.4934969119f, -0.9313836179f, -0.4027107845f),
                  float3(-0.8294889696f, 1.7626640603f, 0.0236246858f),
                  float3(0.0358458302f, -0.0761723893f, 0.9568845240f), rgb);
  }
  float cwp_norm = 1.0f;
  if (display_gamut == 0 && cwp == 3) cwp_norm = 0.9559369922f;
  else if ((display_gamut == 1 || display_gamut == 2) && cwp == 3) cwp_norm = 0.9643201867f;
  else if (display_gamut == 3 && cwp == 2) cwp_norm = 0.9233821937f;
  return rgb * (cwp_norm * cwp_f + 1.0f - cwp_f);
}

static float3 DrtOpenDrtTransformFwd(float3 input_color, uint64_t p) {
  // AP1 to XYZ, then XYZ to P3D65.
  float3 rgb = DrtRows(float3(0.6524187177f, 0.1271799255f, 0.1708572838f),
                       float3(0.2680640592f, 0.6724644790f, 0.0594714618f),
                       float3(-0.0054699285f, 0.0051828000f, 1.0893448793f), input_color);
  rgb        = DrtRows(float3(2.4934969119f, -0.9313836179f, -0.4027107845f),
                       float3(-0.8294889696f, 1.7626640603f, 0.0236246858f),
                       float3(0.0358458302f, -0.0761723893f, 0.9568845240f), rgb);

  const float  rs_rw = DrtF(p, ALCEDO_VK_DRT_ODRT_RS_RW);
  const float  rs_bw = DrtF(p, ALCEDO_VK_DRT_ODRT_RS_BW);
  const float  rs_sa = DrtF(p, ALCEDO_VK_DRT_ODRT_RS_SA);
  const float3 rs_w  = float3(rs_rw, 1.0f - rs_rw - rs_bw, rs_bw);
  float        sat_L = rgb.x * rs_w.x + rgb.y * rs_w.y + rgb.z * rs_w.z;
  rgb                = float3(sat_L) * rs_sa + rgb * (1.0f - rs_sa);
  rgb += float3(DrtF(p, ALCEDO_VK_DRT_ODRT_TN_OFF));
  float tsn = DrtOdrtHypot3(rgb) / kDrtOpenDrtSqrt3;
  rgb       = (abs(tsn) < 1e-8f) ? float3(0.0f) : rgb / tsn;

  const float2 opp   = DrtOdrtOpponent(rgb);
  const float  ach_d = 1.25f * DrtOdrtCompressToeQuadratic(DrtOdrtHypot2(opp) / 2.0f, 0.25f);
  const float  hue   = DrtFmod(AlcedoAtan2(opp.x, opp.y) + kDrtPi + 1.10714931f, 2.0f * kDrtPi);
  const float3 ha_rgb = float3(DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, 0.1f), 0.66f),
                               DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, 4.3f), 0.66f),
                               DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, 2.3f), 0.66f));
  const float3 ha_rgb_hs = float3(DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, -0.4f), 0.66f),
                                  ha_rgb.y,
                                  DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, 2.5f), 0.66f));
  const float3 ha_cmy = float3(DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, 3.3f), 0.5f),
                               DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, 1.3f), 0.5f),
                               DrtOdrtGaussWindow(DrtOdrtHueOffset(hue, -1.15f), 0.5f));

  if (DrtI(p, ALCEDO_VK_DRT_ODRT_BRL_ENABLE) != 0) {
    const float brl_tsf = DrtPow(tsn / (tsn + 1.0f), 1.0f - DrtF(p, ALCEDO_VK_DRT_ODRT_BRL_RNG));
    const float brl_exf =
        (DrtF(p, ALCEDO_VK_DRT_ODRT_BRL) + DrtF(p, ALCEDO_VK_DRT_ODRT_BRL_R) * ha_rgb.x +
         DrtF(p, ALCEDO_VK_DRT_ODRT_BRL_G) * ha_rgb.y + DrtF(p, ALCEDO_VK_DRT_ODRT_BRL_B) * ha_rgb.z) *
        DrtPow(ach_d, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_BRL_ST));
    tsn *= DrtPow(2.0f, brl_exf * ((brl_exf < 0.0f) ? brl_tsf : 1.0f - brl_tsf));
  }
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_TN_LCON_ENABLE) != 0) {
    const float lcon_m = DrtPow(2.0f, -DrtF(p, ALCEDO_VK_DRT_ODRT_TN_LCON));
    float       lcon_w = DrtF(p, ALCEDO_VK_DRT_ODRT_TN_LCON_W) / 4.0f;
    lcon_w *= lcon_w;
    const float ts_x0 = DrtF(p, ALCEDO_VK_DRT_ODRT_TS_X0);
    tsn *= DrtOdrtCompressToeCubic(ts_x0, lcon_m, lcon_w, 1) / ts_x0;
    tsn = DrtOdrtCompressToeCubic(tsn, lcon_m, lcon_w, 0);
  }
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_TN_HCON_ENABLE) != 0) {
    tsn = DrtOdrtContrastHigh(tsn, DrtPow(2.0f, DrtF(p, ALCEDO_VK_DRT_ODRT_TN_HCON)),
                              DrtF(p, ALCEDO_VK_DRT_ODRT_TN_HCON_PV),
                              DrtF(p, ALCEDO_VK_DRT_ODRT_TN_HCON_ST));
  }

  const float ts_p      = DrtF(p, ALCEDO_VK_DRT_ODRT_TS_P);
  const float tsn_pt    = DrtOdrtCompressHyperbolicPower(tsn, DrtF(p, ALCEDO_VK_DRT_ODRT_TS_S1), ts_p);
  const float tsn_const =
      DrtOdrtCompressHyperbolicPower(tsn, DrtF(p, ALCEDO_VK_DRT_ODRT_S_LP100), ts_p);
  tsn = DrtOdrtCompressHyperbolicPower(tsn, DrtF(p, ALCEDO_VK_DRT_ODRT_TS_S), ts_p);

  if (DrtI(p, ALCEDO_VK_DRT_ODRT_HC_ENABLE) != 0) {
    float       hc_ts = 1.0f - tsn_const;
    const float hc_c  = (hc_ts * (1.0f - ach_d) + ach_d * (1.0f - hc_ts)) * ach_d * ha_rgb.x;
    hc_ts             = DrtPow(hc_ts, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HC_R_RNG));
    const float hc_f  = DrtF(p, ALCEDO_VK_DRT_ODRT_HC_R) * (hc_c - 2.0f * hc_c * hc_ts) + 1.0f;
    rgb.y *= hc_f;
    rgb.z *= hc_f;
  }
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_HS_RGB_ENABLE) != 0) {
    const float3 hs_rgb =
        float3(ha_rgb_hs.x * ach_d * DrtPow(tsn_pt, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HS_R_RNG)),
               ha_rgb_hs.y * ach_d * DrtPow(tsn_pt, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HS_G_RNG)),
               ha_rgb_hs.z * ach_d * DrtPow(tsn_pt, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HS_B_RNG)));
    const float hs_r = DrtF(p, ALCEDO_VK_DRT_ODRT_HS_R);
    const float hs_g = DrtF(p, ALCEDO_VK_DRT_ODRT_HS_G);
    const float hs_b = DrtF(p, ALCEDO_VK_DRT_ODRT_HS_B);
    rgb += float3((hs_rgb.z * -hs_b) - (hs_rgb.y * -hs_g), (hs_rgb.x * hs_r) - (hs_rgb.z * -hs_b),
                  (hs_rgb.y * -hs_g) - (hs_rgb.x * hs_r));
  }
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_HS_CMY_ENABLE) != 0) {
    const float  tsn_pt_compl = 1.0f - tsn_pt;
    const float3 hs_cmy       = float3(
        ha_cmy.x * ach_d * DrtPow(tsn_pt_compl, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HS_C_RNG)),
        ha_cmy.y * ach_d * DrtPow(tsn_pt_compl, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HS_M_RNG)),
        ha_cmy.z * ach_d * DrtPow(tsn_pt_compl, 1.0f / DrtF(p, ALCEDO_VK_DRT_ODRT_HS_Y_RNG)));
    const float hs_c = DrtF(p, ALCEDO_VK_DRT_ODRT_HS_C);
    const float hs_m = DrtF(p, ALCEDO_VK_DRT_ODRT_HS_M);
    const float hs_y = DrtF(p, ALCEDO_VK_DRT_ODRT_HS_Y);
    rgb += float3((hs_cmy.z * hs_y) - (hs_cmy.y * hs_m), (hs_cmy.x * -hs_c) - (hs_cmy.z * hs_y),
                  (hs_cmy.y * hs_m) - (hs_cmy.x * -hs_c));
  }

  const float pt_lml_p =
      1.0f + 4.0f * (1.0f - tsn_pt) *
                 (DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LML) + DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LML_R) * ha_rgb_hs.x +
                  DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LML_G) * ha_rgb_hs.y +
                  DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LML_B) * ha_rgb_hs.z);
  float ptf = DrtPow(1.0f - DrtPow(tsn_pt, pt_lml_p),
                     (1.0f - ach_d * (DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LMH_R) * ha_rgb_hs.x +
                                      DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LMH_B) * ha_rgb_hs.z)) *
                         (1.0f - DrtF(p, ALCEDO_VK_DRT_ODRT_PT_LMH) * ach_d));
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_PTM_ENABLE) != 0) {
    const float ptm_low_st  = DrtF(p, ALCEDO_VK_DRT_ODRT_PTM_LOW_ST);
    const float ptm_low_rng = DrtF(p, ALCEDO_VK_DRT_ODRT_PTM_LOW_RNG);
    float       ptm_low_f   = 1.0f;
    if (ptm_low_st != 0.0f && ptm_low_rng != 0.0f) {
      ptm_low_f = 1.0f + DrtF(p, ALCEDO_VK_DRT_ODRT_PTM_LOW) *
                             AlcedoExp(-2.0f * ach_d * ach_d / ptm_low_st) *
                             DrtPow(1.0f - tsn_const, 1.0f / ptm_low_rng);
    }
    const float ptm_high_st  = DrtF(p, ALCEDO_VK_DRT_ODRT_PTM_HIGH_ST);
    const float ptm_high_rng = DrtF(p, ALCEDO_VK_DRT_ODRT_PTM_HIGH_RNG);
    float       ptm_high_f   = 1.0f;
    if (ptm_high_st != 0.0f && ptm_high_rng != 0.0f) {
      ptm_high_f = 1.0f + DrtF(p, ALCEDO_VK_DRT_ODRT_PTM_HIGH) *
                              AlcedoExp(-2.0f * ach_d * ach_d / ptm_high_st) *
                              DrtPow(tsn_pt, 1.0f / (4.0f * ptm_high_rng));
    }
    ptf *= ptm_low_f * ptm_high_f;
  }
  rgb = rgb * ptf + float3(1.0f - ptf);

  sat_L = rgb.x * rs_w.x + rgb.y * rs_w.y + rgb.z * rs_w.z;
  rgb   = (float3(sat_L) * rs_sa - rgb) / (rs_sa - 1.0f);
  const int display_gamut = DrtI(p, ALCEDO_VK_DRT_ODRT_DISPLAY_GAMUT);
  rgb = DrtOdrtDisplayGamutWhitepoint(rgb, tsn_const, DrtF(p, ALCEDO_VK_DRT_ODRT_CWP_LM),
                                      display_gamut, DrtI(p, ALCEDO_VK_DRT_ODRT_CREATIVE_WHITE));
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_BRLP_ENABLE) != 0) {
    float brlp_ach_d         = DrtOdrtHypot2(DrtOdrtOpponent(rgb)) / 4.0f;
    brlp_ach_d               = 1.1f * (brlp_ach_d * brlp_ach_d / (brlp_ach_d + 0.1f));
    const float3 brlp_ha_rgb = ha_rgb * ach_d;
    const float  brlp_m      = DrtF(p, ALCEDO_VK_DRT_ODRT_BRLP) +
                         DrtF(p, ALCEDO_VK_DRT_ODRT_BRLP_R) * brlp_ha_rgb.x +
                         DrtF(p, ALCEDO_VK_DRT_ODRT_BRLP_G) * brlp_ha_rgb.y +
                         DrtF(p, ALCEDO_VK_DRT_ODRT_BRLP_B) * brlp_ha_rgb.z;
    rgb *= DrtPow(2.0f, brlp_m * brlp_ach_d * tsn);
  }
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_PTL_ENABLE) != 0) {
    rgb = float3(DrtOdrtSoftplus(rgb.x, DrtF(p, ALCEDO_VK_DRT_ODRT_PTL_C)),
                 DrtOdrtSoftplus(rgb.y, DrtF(p, ALCEDO_VK_DRT_ODRT_PTL_M)),
                 DrtOdrtSoftplus(rgb.z, DrtF(p, ALCEDO_VK_DRT_ODRT_PTL_Y)));
  }
  tsn *= DrtF(p, ALCEDO_VK_DRT_ODRT_TS_M2);
  tsn = DrtOdrtCompressToeQuadratic(tsn, DrtF(p, ALCEDO_VK_DRT_ODRT_TN_TOE));
  tsn *= DrtF(p, ALCEDO_VK_DRT_ODRT_TS_DSC);
  rgb *= tsn;
  if (display_gamut == 2) {
    rgb = max(rgb, float3(0.0f));
    // P3 to Rec.2020.
    rgb = DrtRows(float3(0.7538330344f, 0.1985973691f, 0.0475695966f),
                  float3(0.0457438490f, 0.9417772198f, 0.0124789312f),
                  float3(-0.0012103404f, 0.0176017173f, 0.9836086231f), rgb);
  }
  if (DrtI(p, ALCEDO_VK_DRT_ODRT_CLAMP) != 0) {
    rgb = clamp(rgb, float3(0.0f), float3(1.0f));
  }
  return rgb;
}

// ---- DrtDisplayPixel of drt.cl -----------------------------------------------------------------

// The display transform of one pixel of linear AP1 with the encoding of the output: the entry
// ACES reference gamut compression, then ACES 2.0 or OpenDRT, then the display encoding.
static float3 DrtDisplayPixel(float3 ap1, uint64_t block) {
  const AcesRgcRgb compressed = AcesReferenceGamutCompress(ap1.x, ap1.y, ap1.z);
  const float3     scene      = float3(compressed.r, compressed.g, compressed.b);
  float3           display_linear;
  if (DrtI(block, ALCEDO_VK_DRT_METHOD) == 0) {
    display_linear = DrtAcesOutputTransformFwd(scene, block);
  } else {
    display_linear = DrtOpenDrtTransformFwd(scene, block);
  }
  return DrtDisplayEncoding(display_linear, block);
}
