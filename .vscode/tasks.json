        "${workspaceFolder}\\build\\release",
        "-Preset",
        "win_release",
        "-Channel",
        "beta"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
