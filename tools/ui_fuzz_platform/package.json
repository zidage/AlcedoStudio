{
  "name": "ui-fuzz-platform",
  "version": "0.1.0",
  "private": true,
  "description": "UI fuzz automation platform: YAML runner core plus Ant Design Pro dashboard for live host control.",
  "type": "module",
  "bin": {
    "fuzz": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm build:runner && pnpm build:web",
    "build:runner": "tsc -p tsconfig.build.json",
    "build:web": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "tsx src/cli.ts",
    "fuzz:build": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dashboard": "tsx src/dashboard/cli.ts",
    "dev": "tsx src/dashboard/cli.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/pro-components": "3.1.14-6",
    "@tanstack/react-query": "^5.80.0",
    "@xyflow/react": "^12.11.2",
    "ajv": "^8.17.1",
    "antd": "^6.5.3",
    "better-sqlite3": "^13.0.2",
    "js-yaml": "^4.1.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
