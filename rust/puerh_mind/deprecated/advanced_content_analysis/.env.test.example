# Alcedo AI sidecar — Phase 5c live smoke test credentials.
#
# Copy this file to `.env.test` and fill in real API keys to run the env-gated
# live smoke tests with `cargo test`. `.env.test` is gitignored — never commit
# real keys. With a key unset or empty, the matching smoke test is skipped (a
# clean no-op pass), so `cargo test` without credentials still succeeds.
#
# These tests call the REAL provider endpoints and may incur cost. They are for
# manual validation only; the mock-server tests (no network, no cost) are the CI
# gate. Existing process env vars take precedence over this file (dotenvy does
# not override already-set variables), so you can also export the keys in your
# shell instead of editing this file.

# OpenRouter — https://openrouter.ai  (used by live_openrouter_smoke_*).
# Accepts either name; ALCEDO_OPENROUTER_API_KEY is preferred.
ALCEDO_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=

# Volcengine Ark / 火山方舟 — https://www.volcengine.com/product/ark
# (used by live_volcengine_ark_smoke_* AND live_volcengine_ark_coding_smoke_*).
# The Coding Plan smoke (Anthropic-compatible /api/coding/v1/messages) reuses the
# SAME Ark key — no separate env var. Accepts either name;
# ALCEDO_VOLCENGINE_ARK_API_KEY is preferred; ALCEDO_ARK_API_KEY is the fallback.
ALCEDO_VOLCENGINE_ARK_API_KEY=
ALCEDO_ARK_API_KEY=

# Opencode — https://opencode.ai
# Used by the Rust live_opencode_openai_batch_analyze_smoke and by the C++
# ImageAnalysisServiceLiveTest validate-connection/model-discovery smoke. Accepts
# either name; ALCEDO_OPENCODE_API_KEY is preferred.
ALCEDO_OPENCODE_API_KEY=
OPENCODE_API_KEY=
