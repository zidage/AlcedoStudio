{
  "schema_version": 1,
  "provider_id": "ccswitch_openai",
  "display_name": "CC Switch Routing (OpenAI-compatible)",
  "driver": "openai_chat_compatible",
  "base_url": "http://127.0.0.1:15721/v1",
  "endpoint": "/chat/completions",
  "auth": {
    "type": "none",
    "credential_slot": "ccswitch_local_route"
  },
  "defaults": {
    "model": "ccswitch-routed",
    "stream": false,
    "temperature": 0.2
  },
  "structured_output": {
    "mode": "response_format_json_schema",
    "strict": true
  },
  "response": {
    "content_json_pointer": "/choices/0/message/content",
    "usage_json_pointer": "/usage",
    "provider_request_id_json_pointer": "/id",
    "provider_request_id_header": null
  },
  "models_response": {
    "data_json_pointer": "/models"
  },
  "limits": {
    "timeout_ms": 60000,
    "max_image_bytes": 4194304,
    "max_output_tokens": 1200
  },
  "models": [
    {
      "slug": "ccswitch-routed",
      "display_name": "CC Switch routed model",
      "supports_vision": true,
      "supports_structured_output": true,
      "live_confirmed": false,
      "max_image_bytes": 4194304,
      "recommended_rendition": "preview"
    }
  ]
}
